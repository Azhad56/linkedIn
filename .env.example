# Copy this file to .env and fill in your values.
# NEVER commit .env
# Login session is stored separately in data/chrome-profile/ (gitignored).

CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_PHONE_COUNTRY=India (+91)
CANDIDATE_LOCATION=
TOTAL_YEARS_EXPERIENCE=5
CURRENT_CTC_LPA=
EXPECTED_CTC_LPA=
NOTICE_PERIOD_DAYS=0
NOTICE_PERIOD_TEXT=Immediate
WILLING_TO_RELOCATE=true
WILLING_TO_TRAVEL=true
REQUIRES_SPONSORSHIP=false

SEARCH_KEYWORDS=Node.js Developer,Backend Developer,Full Stack Developer
SEARCH_LOCATION=India
SEARCH_DATE_POSTED=week

MAX_APPLICATIONS_PER_RUN=15
MAX_APPLICATIONS_PER_KEYWORD=8
MAX_PAGES_PER_KEYWORD=5

AI_ENABLED=true
AI_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434/api/generate
